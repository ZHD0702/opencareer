# OpenCareer 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== API 密钥 ====================
# DeepSeek API (必需)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (可选，用于备用)
OPENAI_API_KEY=

# Anthropic API (可选，用于 Claude)
ANTHROPIC_API_KEY=

# ==================== LLM 配置 ====================
# 使用的 LLM 提供商: deepseek / openai / anthropic
LLM_PROVIDER=deepseek

# ==================== MCP 配置 ====================
# 启用 MCP (resume-skill)
CAREER_USE_MCP=true

# MCP 服务器 URL (Docker 部署时使用服务名)
CAREER_MCP_URL=http://mcp-server:8001/mcp

# MCP 主机和端口
CAREER_MCP_HOST=127.0.0.1
CAREER_MCP_PORT=8001

# ==================== 服务器配置 ====================
# 后端端口
PORT=8000
HOST=0.0.0.0

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:8000

# ==================== 数据库配置 ====================
DATABASE_URL=sqlite:///./data/app.db

# ==================== 其他配置 ====================
DEBUG=false
